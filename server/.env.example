# Which LLM to use: "gemini" (free tier) or "openai" (paid, very cheap with gpt-4.1-mini)
LLM_PROVIDER=gemini

# Google AI Studio key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI key (only if LLM_PROVIDER=openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ElevenLabs key (free plan). Key needs Speech-to-Text AND Text-to-Speech permissions.
ELEVENLABS_API_KEY=
# Must be a DEFAULT voice on the free plan (Voice Library voices return 402 via the API).
# EXAVITQu4vr4xnSDxMaL is "Sarah", a default voice.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

CLINIC_TZ=Asia/Kolkata
